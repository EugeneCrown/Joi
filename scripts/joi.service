[Unit]
Description=Joi AI assistant server
After=network.target

[Service]
User=grebenkine
Group=grebenkine
WorkingDirectory=/home/grebenkine/Joi
Environment=PYTHONPATH=/home/grebenkine/Joi/server
ExecStart=/home/grebenkine/Joi/.venv/bin/python -m uvicorn joi:app --host 0.0.0.0 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
