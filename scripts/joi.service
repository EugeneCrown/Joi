[Unit]
Description=Joi AI assistant server
After=network.target

[Service]
User=grebenkine
Group=grebenkine
WorkingDirectory=/home/grebenkine/Joi
ExecStart=/home/grebenkine/Joi/.venv/bin/uvicorn joi.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
Environment=PYTHONPATH=server

[Install]
WantedBy=multi-user.target
