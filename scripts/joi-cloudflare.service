[Unit]
Description=Cloudflare Tunnel for Joi
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/default/joi-cloudflare
# CLOUDFLARED_TUNNEL_ID – UUID туннеля, задаётся в переменной окружения (например, в /etc/default/joi-cloudflare)
ExecStart=cloudflared tunnel run 49c23147-40df-4551-ac5b-19ee47baeec3 --config /home/grebenkine/Joi/cloudflare/tunnel.yml
Restart=on-failure
User=grebenkine
Group=grebenkine
Environment="HOME=/home/grebenkine"

[Install]
WantedBy=multi-user.target
